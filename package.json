{
  "name": "rss-worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "start": "wrangler dev",
    "dev": "wrangler dev",
    "build": "node build.mjs",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "wrangler": "^3.12.2",                // 升级到最新稳定版
    "@rollup/plugin-inject": "^5.0.3",     // 替换废弃的 rollup-plugin-inject
    "@jridgewell/sourcemap-codec": "^1.4.15", // 替换废弃的 sourcemap-codec
    "glob": "^10.3.10",                    // 升级 glob 到 v10+
    "rimraf": "^5.0.5",                    // 升级 rimraf 到 v5+
    "esbuild": "^0.20.2"                   // 显式声明 esbuild 版本
  },
  "dependencies": {
    "@bufbuild/buf": "^1.28.1",            // 升级到最新版
    "@connectrpc/connect": "^1.4.0",       // 替换 @bufbuild/connect
    "@connectrpc/connect-node": "^1.4.0",  // 替换 @bufbuild/connect-node
    "@connectrpc/connect-web": "^1.4.0",   // 替换 @bufbuild/connect-web
    "@bufbuild/protobuf": "^1.3.1",
    "@connectrpc/protoc-gen-connect-es": "^1.4.0", // 替换作用域
    "@bufbuild/protoc-gen-es": "^1.3.1",
    "dayjs": "^1.11.11",                   // 升级到最新版
    "hono": "^3.12.8",                     // 升级到最新版
    "hpack": "^1.0.0",
    "mustache": "^4.2.0",
    "node-forge": "^1.3.1",
    "patch-package": "^8.0.0",
    "runes2": "^1.1.4"
  },
  "overrides": {
    // 强制覆盖间接依赖的旧版本
    "rollup-plugin-inject": "npm:@rollup/plugin-inject@^5.0.3",
    "sourcemap-codec": "npm:@jridgewell/sourcemap-codec@^1.4.15"
  }
}
